# Every file under /_next/static/ is content-hashed by Next.js (a new build produces new
# filenames), so it's safe to cache forever -- the browser only ever refetches when the
# filename itself changes. Read by Cloudflare Workers assets at deploy time (wrangler.jsonc's
# assets.directory is "out", and `next build` with output:"export" copies this file there
# unchanged since it's under public/).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker script itself must always be revalidated -- browsers already re-check it
# at most every 24h regardless of headers, but a long max-age here would fight that and delay
# users picking up a new deploy (see scripts/generate-sw.mjs).
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Badge artwork is content-hashed too: scripts/optimize-badges.mjs names every file
# `<name>.<hash>.webp`, with the hash derived from the master image and the resize settings, so a
# changed badge always gets a new URL and the old one can be cached forever. (These two rules
# deliberately don't overlap with the icon rule below -- Cloudflare merges the headers of every
# matching rule, which would join two conflicting Cache-Control values into one.)
/images/badges/thumb/*
  Cache-Control: public, max-age=31536000, immutable
/images/badges/full/*
  Cache-Control: public, max-age=31536000, immutable

# App icons and PWA manifest change only on redeploy but aren't content-hashed --
# short browser cache plus stale-while-revalidate lets Cloudflare's edge serve
# the cached copy instantly while it quietly refetches in the background.
/images/icon-*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/icon.svg
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/apple-icon.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/opengraph-image.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/twitter-image.png
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/manifest.webmanifest
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

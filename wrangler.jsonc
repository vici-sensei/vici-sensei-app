{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vici-sensei-app",
  "compatibility_date": "2026-01-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "out",
    // Only /api/* goes to the Worker below; everything else (the static export) is served
    // by Cloudflare's Asset Worker directly, same as before this file had a "main" at all.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS_DB",
      "database_name": "vici-sensei-accounts",
      "database_id": "d25a5332-b73d-4fb5-9398-4ab3582bac67"
    }
  ],
  "triggers": {
    // All crons hit the same `scheduled()` handler in worker/index.ts, which branches on
    // `event.cron` -- daily keep-alive ping (Free-plan projects pause after 7 days idle), weekly
    // D1-vs-auth.users reconciliation, hourly copying of Google profile photos into Storage
    // (worker/lib/avatarMirror.ts), and a monthly SMTP heartbeat (worker/lib/smtpHeartbeat.ts) that
    // keeps the Brevo SMTP key from expiring after 90 days of inactivity, and every 5 minutes the lesson
    // notifications (worker/lib/lessonsNotify.ts: stores what is due, sends the emails that are waiting).
    // Cloudflare Free allows 5 cron triggers per account: this is the fifth, so another Worker on the
    // same account with a cron of its own would need the paid plan.
    "crons": ["0 3 * * *", "0 4 * * 1", "17 * * * *", "0 5 1 * *", "*/5 * * * *"]
  },
  // Workers Logs: keeps console.log/console.error and one record per invocation (requests and cron runs),
  // readable in the Cloudflare dashboard -> this Worker -> Observability. Without it nothing the Worker
  // prints is kept, which hid why the every-5-minutes lesson job did nothing (2026-10-08).
  "observability": { "enabled": true },
  // Not secret (see .env.local / lib/supabase/regions.ts, which use the same values) -- safe as
  // plain vars. The AUTH_HOOK_SECRET_EU/US and SUPABASE_SERVICE_ROLE_KEY_EU/US this Worker also
  // reads are genuine secrets, set with `wrangler secret put <name>` instead (never committed).
  "vars": {
    "SUPABASE_URL_EU": "https://zrgcullndfhouencqqqc.supabase.co",
    "SUPABASE_ANON_KEY_EU": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpyZ2N1bGxuZGZob3VlbmNxcXFjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwMzk0MjIsImV4cCI6MjEwNTYxNTQyMn0.id3Lgeln24nnviUnvXi102yb_rtPGCQrxLpOsXgDukk",
    "SUPABASE_URL_US": "https://wftwdbiqnlqsvgpeypmb.supabase.co",
    "SUPABASE_ANON_KEY_US": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndmdHdkYmlxbmxxc3ZncGV5cG1iIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwNDUzNzgsImV4cCI6MjEwNTYyMTM3OH0.aj8LM_elsVQ05dtmWH1-UrE4MnL0swTYKQXlKKLeu1E"
  }
}
